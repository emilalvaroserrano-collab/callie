# Required configuration
#
# Set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview and Development). For local development, copy this
# file to `.env` and fill in the values.
#
# Next.js reads these on the server. Firebase and Vapi keys are passed to the
# browser as runtime configuration by the server pages — never hardcoded in the
# repository, and never prefixed with NEXT_PUBLIC_.
#
# The master agent system prompt lives in `lib/agent-system-prompt.json` and is
# only loaded by the `/api/vapi-overrides` server route.

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Vapi (public web key only — never the private key)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
