# Required configuration
#
# Set these in Vercel → Project → Settings → Environment Variables
# (Production, Preview and Development). For local development, copy this
# file to `.env` and fill in the values.
#
# `npm run build` (scripts/inject-env.mjs) generates config.js from them.
# config.js and .env are gitignored — no keys are committed to the repo.

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Vapi
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
